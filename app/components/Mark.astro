---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<span class="brand-mark" style={`--mark-size: ${size}px`} aria-hidden="true">
  <img
    class="brand-mark-light"
    src="/images/brand/sibsys-light.webp"
    width="256"
    height="256"
    alt=""
  />
  <img
    class="brand-mark-dark"
    src="/images/brand/sibsys-dark.webp"
    width="256"
    height="256"
    alt=""
  />
</span>
